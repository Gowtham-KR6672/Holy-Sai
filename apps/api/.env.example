# Copy to .env and fill in. Never commit .env.

# PostgreSQL. For local development run `npm run db:start` at the repo root.
# One database holds everything: the "platform" schema (We School itself) and one schema per school (ws_<code>).
DATABASE_URL=postgresql://holysai:holysai_dev@localhost:5433/holysai_app

PORT=4000
# Web app origin(s) allowed to call the API, comma separated.
WEB_ORIGIN=http://localhost:5173,http://localhost:8081
# The web app's public address (payment return links). Defaults to the first WEB_ORIGIN.
# PUBLIC_WEB_URL=https://app.weschool.example
NODE_ENV=development

# Signs school users' access tokens. Use a long random string (64+ characters).
JWT_ACCESS_SECRET=change-me
# Signs We School platform admins' tokens. A different long random string.
PLATFORM_JWT_SECRET=change-me
# Access token lifetime in seconds.
JWT_ACCESS_TTL=900

# 32-byte key (base64) used to encrypt AI, integration and payment-gateway secrets at rest.
APP_ENCRYPTION_KEY=change-me

# The We School platform Super Admin, created by `npm run db:seed` only if no platform admin exists.
SEED_ADMIN_NAME=We School Administrator
SEED_ADMIN_EMAIL=admin@weschool.example
SEED_ADMIN_PASSWORD=change-me

# Where uploaded files are stored when a school's storage integration is "Local disk" (one folder per school).
UPLOAD_DIR=./uploads

# Optional tuning for many schools: open school databases kept at once, and pooled connections per school.
# MAX_LIVE_WORKSPACES=15
# WORKSPACE_DB_CONNECTION_LIMIT=3

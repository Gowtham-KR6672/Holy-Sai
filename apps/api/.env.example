# Copy to .env and fill in. Never commit .env.

# PostgreSQL. For local development run `npm run db:start` at the repo root.
DATABASE_URL=postgresql://holysai:holysai_dev@localhost:5433/holysai_app

PORT=4000
# Web app origin(s) allowed to call the API, comma separated.
WEB_ORIGIN=http://localhost:5173,http://localhost:8081
NODE_ENV=development

# Signs access tokens. Use a long random string (64+ characters).
JWT_ACCESS_SECRET=change-me
# Access token lifetime in seconds.
JWT_ACCESS_TTL=900

# 32-byte key (base64) used to encrypt AI and integration secrets at rest.
APP_ENCRYPTION_KEY=change-me

# First Super Admin, created by `npm run db:seed` only if no Super Admin exists.
SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_EMAIL=admin@holysai.edu
SEED_ADMIN_PASSWORD=change-me

# Where uploaded files are stored when the storage integration is "Local disk".
UPLOAD_DIR=./uploads

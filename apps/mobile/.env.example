# Copy to .env (or .env.local) and adjust. Values are baked into the bundle at build time.
#
# The Holy Sai API (NestJS, apps/api). Defaults when unset:
#   Android emulator  http://10.0.2.2:4000/api
#   iOS simulator     http://localhost:4000/api
# A physical phone needs your computer's LAN address, e.g. http://192.168.1.20:4000/api
EXPO_PUBLIC_API_URL=

# The web portal (apps/web). Features without a native screen open here. Defaults to port 5173 on the same host.
EXPO_PUBLIC_WEB_URL=
